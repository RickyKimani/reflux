# `v fmt` writes LF. Git on Windows checks text out as CRLF by default, and
# then `v fmt -verify` would report every file as unformatted. Pin LF for
# everything the tools read or write.
*.v     text eol=lf
*.vsh   text eol=lf
v.mod   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.py    text eol=lf

# Vendored third-party data is kept byte for byte as its authors ship it
# (ChemSep's files have CRLF endings), so the SHA-256 sums in each NOTICE
# stay true on every checkout. Later lines override earlier ones, and
# NOTICE.md itself is ours, so it goes back to LF.
data/vendor/**            -text
data/vendor/**/NOTICE.md  text eol=lf
